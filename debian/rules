#!/usr/bin/make -f

DH_VERBOSE = 1
VER_MAJOR = $(shell dpkg-parsechangelog -S Version | cut -d. -f1)

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_INCLUDEDIR=lib/cef/${DEB_HOST_MULTIARCH}/${VER_MAJOR} \
		-DCMAKE_INSTALL_LIBDIR=lib/cef/${DEB_HOST_MULTIARCH}/${VER_MAJOR} \
		-DCMAKE_INSTALL_CMAKEDIR=lib/${DEB_HOST_MULTIARCH}/cmake/CEF${VER_MAJOR}
