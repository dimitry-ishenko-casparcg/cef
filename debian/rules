#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk

export DH_VERBOSE = 1
export MAJOR := $(firstword $(subst ., ,$(DEB_VERSION_UPSTREAM)))

HEADER  := include/cef_api_versions.h
WRAPPER := libcef_dll_wrapper

BUILDDIR:= obj-$(DEB_HOST_GNU_TYPE)
CMAKEDIR:= /usr/lib/$(DEB_HOST_MULTIARCH)/cmake
LIBDIR  := /usr/lib/cef/$(DEB_HOST_MULTIARCH)/$(MAJOR)
LIBRARY := libcef$(MAJOR)-$(DEB_HOST_ARCH)

APIS := $(shell debian/get-apis.sh $(HEADER))
ifeq ($(strip $(APIS)),)
$(error no stable APIs found in $(HEADER))
endif

CEF_CMAKE := CEFConfig.cmake CEFConfigVersion.cmake CEFTargets.cmake

####################
%:
	dh $@

override_dh_auto_configure:
	set -e; for api in $(APIS); do dh_auto_configure \
		--builddir=$(BUILDDIR)/api$$api -- -DCMAKE_BUILD_TYPE=Release -Dapi_version=$$api; \
	done
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release
	
	set -e; for f in $(CEF_CMAKE); do sed \
		-e "s|@MAJOR@|$(MAJOR)|g" -e "s|@LIBDIR@|$(LIBDIR)|g" -e "s|@APIS@|$(APIS)|g" \
		"debian/$$f.in" > "$(BUILDDIR)/$$f"; \
	done

override_dh_auto_build:
	set -e; for api in $(APIS); do dh_auto_build \
		--builddir=$(BUILDDIR)/api$$api -- $(WRAPPER); \
	done
	dh_auto_build -- $(WRAPPER)

override_dh_auto_install:
	set -e; for api in $(APIS); do install \
		-Dm644 $(BUILDDIR)/api$$api/$(WRAPPER)/$(WRAPPER).a \
		debian/tmp$(LIBDIR)/api$$api/$(WRAPPER).a; \
	done
	
	install -Dm644 -t debian/tmp$(CMAKEDIR)/CEF$(MAJOR) $(addprefix $(BUILDDIR)/,$(CEF_CMAKE))

override_dh_gencontrol:
	debian/gen-substvars.sh $(HEADER) $(LIBRARY)
	dh_gencontrol

override_dh_dwz:

override_dh_installdeb:
	debian/gen-maintscripts.sh $(HEADER) $(LIBRARY) $(DEB_HOST_MULTIARCH) $(MAJOR)
	dh_installdeb

execute_before_dh_clean:
	rm -f debian/$(LIBRARY).postinst debian/$(LIBRARY).prerm
